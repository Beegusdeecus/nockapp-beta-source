{
  "name": "nockapp-extension",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-firefox.mjs && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/test.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "events": "3.3.0",
    "metamask-extension-provider": "5.0.0",
    "process": "0.11.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
